# Set up prompt
autoload -Uz vcs_info
precmd() { vcs_info }

# Add git branch to prompt
zstyle ':vcs_info:git:*' formats '%b'

setopt PROMPT_SUBST
# %30>…> caps the branch name at 30 columns, marking cuts with an ellipsis
PROMPT='%F{green}%D{%T}%f %F{cyan}%~%f %F{magenta}%30>…>${vcs_info_msg_0_}%>>%f${vcs_info_msg_0_:+ }$ '
